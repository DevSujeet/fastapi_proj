# DEVELOPMENT_DATABASE_HOST="dev_envfile_host"
# DEVELOPMENT_DATABASE_USERNAME='dev_test_username'
# DEVELOPMENT_DATABASE_PASSWORD='dev_test_password'

# PRODUCTION_DATABASE_HOST="prod_envfile_host"
# PRODUCTION_DATABASE_USERNAME='prod_test_username'
# PRODUCTION_DATABASE_PASSWORD='prod_test_password'

#postgresql+asyncpg://username:password@hostname:port/databasename
DEVELOPMENT_DATABASE_DRIVERNAME=postgresql
DEVELOPMENT_DATABASE_USERNAME=postgres  #username@dev_database
DEVELOPMENT_DATABASE_PASSWORD=postgres  #pass123!
DEVELOPMENT_DATABASE_HOST=db #dev_database.postgres.database.azure.com
DEVELOPMENT_DATABASE_NAME=vodafone
DEVELOPMENT_DATABASE_PORT=5432


#redis://user:password@localhost:6379
DEVELOPMENT_CACHE_DRIVERNAME=redis
DEVELOPMENT_CACHE_USERNAME=username@dev_database
DEVELOPMENT_CACHE_PASSWORD=pass123!
DEVELOPMENT_CACHE_HOST=localhost #dev_database.postgres.database.azure.com
DEVELOPMENT_CACHE_NAME=vodafone
DEVELOPMENT_CACHE_PORT=6379

#SAML information
SAML_PUBLIC_CERT_PATH=/etc/yourapp/certs/azure_saml_public.pem
SAML_ENTITY_ID=your-service-provider-entity-id
SAML_IDP_ENTITY_ID=your-idp-entity-id
SAML_SSO_URL=https://your-idp-sso-url

#JWT information
SECRET_KEY=your-secret-key
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth 2.0 Configurations
TENANT_ID=TEST_TENANT_ID
CLIENT_ID=TEST_CLIENT_ID
CLIENT_SECRET=TEST_CLIENT_SECRET
REDIRECT_URI=http://localhost:8000/api/callback
SCOPE=openid profile email User.Read#openid profile email offline_access